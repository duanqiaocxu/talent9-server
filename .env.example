# ===== 人才盘点九宫格 · 授权+支付服务端 配置 =====
# 复制本文件为 .env 并填入真实值后重启 server.js 即进入「生产模式」；
# 不填任何密钥时自动运行 DEMO 模式（不收真实钱，但可跑通全链路）。
PORT=8787

# 客户端 HTML 路径（服务端会同源托管它，避免跨域）
CLIENT_HTML=C:\Users\jsqiang\Desktop\人才盘点九宫格App.html

# ---------- Stripe（国际/信用卡） ----------
# 测试密钥 sk_test_... 来自 https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook 签名密钥，来自 Stripe 后台 /webhooks（本地可用 Stripe CLI: stripe listen --forward-to localhost:8787/api/webhook/stripe）
STRIPE_WEBHOOK_SECRET=
# 正式版价格（单位：分）。¥999.00 = 99900
STRIPE_PRICE_PRO=99900

# ---------- 微信支付 V3（Native 扫码） ----------
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=        # 32 字节，商户平台「APIv3 密钥」
WECHAT_SERIAL=            # 商户 API 证书序列号
WECHAT_PRIVATE_KEY_PATH=  # 商户 RSA 私钥 PEM 绝对路径
WECHAT_PLATFORM_CERT_PATH= # 微信平台证书 PEM 绝对路径（验签回调用）
WECHAT_AMOUNT_PRO=99900   # 单位：分（专业版 ¥999）
WECHAT_AMOUNT_STARTER=19900 # 单位：分（入门版 ¥199）

# ---------- 钉钉接入（企业内部 H5 微应用 · 免登 + 通讯录，可选） ----------
# 在 https://open-dev.dingtalk.com 创建「企业内部应用」后获取；填齐后 /api/config 的 dingtalk=true
DINGTALK_APPKEY=
DINGTALK_APPSECRET=
DINGTALK_CORPID=
DINGTALK_AGENTID=

# ---------- 飞书接入（企业自建应用 · 网页授权/OAuth 与工作台 H5 免登，可选） ----------
# 在 https://open.feishu.cn 创建「企业自建应用」后获取；填齐后 /api/config 的 feishu=true
# 注意：飞书 OAuth 回调 / 工作台主页强制 HTTPS，需把服务端部署到有公网 HTTPS 域名的云主机，
#       并在开放平台「安全设置」登记重定向 URL 与 H5 可信域名。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
